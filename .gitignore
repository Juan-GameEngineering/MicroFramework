###############################################################################
# UNITY (v5 até v6)
###############################################################################

# Diretórios gerados automaticamente
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Ll]ogs/
[Mm]emoryCaptures/
[Uu]ser[Ss]ettings/
[Rr]ecordings/
[Ss]creenshots/

# Builds
[Bb]uild/
[Bb]uilds/
[Bb]in/
[Dd]ist/

# Cache e artefatos internos
*.stackdump
sysinfo.txt

###############################################################################
# UNITY ADDRESSABLES
###############################################################################
[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.json
[Aa]ssets/[Ss]treamingAssets/aa/*
[Aa]ssets/[Ss]treamingAssets/aa.meta

###############################################################################
# IL2CPP / BURST / DEBUG (Unity 2019+)
###############################################################################
*_BackUpThisFolder_ButDontShipItWithYourGame
*_BurstDebugInformation_DoNotShip
*_DoNotShip

###############################################################################
# UNITY PACKAGES / EXPORTS
###############################################################################
*.unitypackage
*.apk
*.aab
*.app
*.exe
*.x86
*.x86_64
*.zip
*.rar

