# C# / .NET
###############################################################################
*.csproj
*.unityproj
*.sln
*.pidb
*.pdb
*.mdb
*.tmp

###############################################################################
# SISTEMA OPERACIONAL
###############################################################################

# Windows
[Tt]humbs.db
ehthumbs.db
Desktop.ini

# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Icon?

# Linux
*~

###############################################################################
# SEGURANÇA / DADOS SENSÍVEIS
###############################################################################

# Configurações locais / segredos
.env
.env.*
*.env

# Chaves e certificados
*.keystore
*.jks
*.p12
*.pem
*.key
*.crt
*.cer

# Credenciais
credentials.json
secrets.json
service-account.json
firebase.json
google-services.json
GoogleService-Info.plist

# Logs locais com possíveis paths / tokens
*.log

###############################################################################
# GIT SAFETY
###############################################################################

# SEMPRE versionar arquivos .meta
!/[Aa]ssets/**/*.meta
